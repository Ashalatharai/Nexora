# Kirana Chat Ledger — Environment Variables Configuration Template
# Copy this file to .env and provide your actual credentials for local deployment.

# Database
DATABASE_URL=sqlite:///./backend/kirana.db

# WhatsApp Business Cloud API (Official Meta Graph API)
# Obtain these from https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verification_token_here
WHATSAPP_API_VERSION=v18.0

# Optional AI LLM Provider (Google Gemini API)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
